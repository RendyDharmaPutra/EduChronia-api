{
  "name": "EduChronia-api",
  "version": "1.0.0",
  "description": "Backend service for EduChronia",
  "author": "Archilst",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target=bun",
    "start": "bun dist/main.js",
    "migrate": "bunx drizzle-kit migrate --config=./drizzle.config.ts"
  },
  "dependencies": {
    "better-auth": "^1.4.17",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.4",
    "pg": "^8.17.1",
    "pino": "^10.2.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8"
  }
}
